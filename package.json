{
  "name": "dungeon-tactics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-game.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "bench": "vite --port 5291 --strictPort",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.scripts.json",
    "build": "vite build",
    "dev": "vite",
    "sim": "node scripts/battle-sim.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.3",
    "playwright-core": "^1.61.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  }
}
